# Gemini API key — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Service Account dùng để ghi/đọc Google Sheets (bảng "KẾT QUẢ HỌC TẬP")
# Xem hướng dẫn tạo trong README.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Upstash Redis (REST) dùng để lưu Bài giảng + Ngân hàng câu hỏi
# Lấy tại https://console.upstash.com hoặc qua Vercel Marketplace > Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tài khoản đăng nhập Giảng viên (để trống sẽ dùng mặc định "giangvien" / "giangvien")
TEACHER_USERNAME=giangvien
TEACHER_PASSWORD=giangvien
